@{
    Layout = "_Layout";
    ViewBag.Titulo = "Início";
}

<div class="row g-4 pb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary">Categorias</h5>
                <p class="card-text text-secondary">Cadastre as categorias de despesas</p>
                <a class="btn btn-outline-primary rounded-pill px-4" href="/Categoria/Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary">Despesas</h5>
                <p class="card-text text-secondary">Cadastre as suas despesas diárias</p>
                <a class="btn btn-outline-primary rounded-pill px-4" href="/Despesa/Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary">Tarefas</h5>
                <p class="card-text text-secondary">Cadastre e gerencie as suas tarefas</p>
                <a class="btn btn-outline-primary rounded-pill px-4" href="/Tarefa/Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary">Contatos</h5>
                <p class="card-text text-secondary">Gerencie a sua agenda de contatos</p>
                <a class="btn btn-outline-primary rounded-pill px-4" href="/Contato/Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary">Compromissos</h5>
                <p class="card-text text-secondary">Gerencie a sua agenda de compromissos</p>
                <a class="btn btn-outline-primary rounded-pill px-4" href="/Compromisso/Listar">Acessar</a>
            </div>
        </div>
    </div>
</div>
@using eAgenda.WebApp.Modulos.Compromissos;
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Compromisso";
}

@model eAgenda.WebApp.Modulos.Compromissos.ExcluirCompromissoViewModel

<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-danger fw-bold">Excluir Compromisso</h2>
    </div>

    <form class="card border-danger-subtle shadow-sm p-4" action="/Compromisso/Excluir" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />

        <p class="fs-5 text-dark mb-4">
            Tem certeza de que deseja excluir o compromisso <strong>"@Model.Assunto"</strong>?
        </p>

        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary rounded-pill px-4" href="/Compromisso/Listar">Cancelar</a>
            <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar Exclusão</button>
        </div>
    </form>
</div>
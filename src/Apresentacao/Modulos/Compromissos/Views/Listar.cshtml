@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Compromissos";
}

@model IEnumerable<eAgenda.Aplicacao.Modulos.Compromissos.CompromissoDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold mb-0">Compromissos</h2>
    <a class="btn btn-primary rounded-pill px-4" asp-action="Cadastrar">Novo Compromisso</a>
</div>

<div class="card border-primary-subtle shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-primary text-uppercase small">
            <tr>
                <th>Assunto</th>
                <th>Data</th>
                <th>Horário</th>
                <th>Tipo</th>
                <th>Local / Link</th>
                <th>Contato</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Nenhum compromisso cadastrado.</td>
                </tr>
            }
            else
            {
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Assunto</td>
                        <td>@c.DataOcorrencia.ToString("dd/MM/yyyy")</td>
                        <td>@c.HoraInicio.ToString("HH:mm") - @c.HoraTermino.ToString("HH:mm")</td>
                        <td>@c.TipoCompromisso</td>
                        <td>@c.LocalOuLink</td>
                        <td>@(c.NomeContato ?? "-")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary rounded-pill me-1" asp-action="Editar"
                               asp-route-id="@c.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger rounded-pill" asp-action="Excluir"
                               asp-route-id="@c.Id">Excluir</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@using eAgenda.Aplicacao.Modulos.Compromissos;
@using eAgenda.WebApp.Modulos.Compromissos;
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Compromisso";
}

@model eAgenda.WebApp.Modulos.Compromissos.CadastrarCompromissoViewModel

<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-primary fw-bold">Cadastrar Novo Compromisso</h2>
    </div>

    <form class="card border-primary-subtle shadow-sm p-4" action="/Compromisso/Cadastrar" method="post">
        <div asp-validation-summary="All" class="text-danger alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Assunto" class="form-label fw-semibold text-primary text-uppercase small">Assunto</label>
            <input asp-for="Assunto" name="Assunto" class="form-control" />
            <span asp-validation-for="Assunto" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TipoLocal" class="form-label fw-semibold text-primary text-uppercase small">Tipo de
                Compromisso</label>
                <select asp-for="TipoLocal" name="TipoLocal" class="form-select">
                    <option value="Presencial">Presencial</option>
                    <option value="Remoto">Remoto</option>
                </select>
                <span asp-validation-for="TipoLocal" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Local" class="form-label fw-semibold text-primary text-uppercase small">Local (se
                    presencial)</label>
                    <input asp-for="Local" name="Local" class="form-control" />
                    <span asp-validation-for="Local" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Link" class="form-label fw-semibold text-primary text-uppercase small">Link (se
                        remoto)</label>
                        <input asp-for="Link" name="Link" class="form-control" />
                        <span asp-validation-for="Link" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Data" class="form-label fw-semibold text-primary text-uppercase small">Data</label>
                            <input asp-for="Data" type="date" name="Data" class="form-control" />
                            <span asp-validation-for="Data" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="HoraInicio"
                                   class="form-label fw-semibold text-primary text-uppercase small">Início</label>
                            <input asp-for="HoraInicio" type="time" name="HoraInicio" class="form-control" />
                            <span asp-validation-for="HoraInicio" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="HoraTermino"
                                   class="form-label fw-semibold text-primary text-uppercase small">Término</label>
                            <input asp-for="HoraTermino" type="time" name="HoraTermino" class="form-control" />
                            <span asp-validation-for="HoraTermino" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a class="btn btn-outline-primary rounded-pill px-4" href="/Compromisso/Listar">Voltar</a>
                        <button class="btn btn-primary rounded-pill px-4" type="submit">Cadastrar</button>
                    </div>
                </form>
            </div>
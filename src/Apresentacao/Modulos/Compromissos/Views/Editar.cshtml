@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Compromisso";
}

@model CadastrarCompromissoViewModel;
@using eAgenda.WebApp.Modulos.Compromissos

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar"
      method="post">
    
    <div class="mb-3">
        <label asp-for="Assunto" class="form-label fw-semibold text-primary text-uppercase small">Assunto</label>
        <input asp-for="Assunto" type="text" class="form-control">
        <span asp-validation-for="Assunto" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TipoLocal" class="form-label fw-semibold text-primary text-uppercase small">Tipo de
            Local</label>
            <select asp-for="TipoLocal" class="form-select">
                <option value="Presencial">Presencial</option>
                <option value="Remoto">Remoto</option>
            </select>
            <span asp-validation-for="TipoLocal" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Local" class="form-label fw-semibold text-primary text-uppercase small">Local
                (Presencial)</label>
                <input asp-for="Local" type="text" class="form-control" placeholder="Ex: Sala de Reuniões 02">
                <span asp-validation-for="Local" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Link" class="form-label fw-semibold text-primary text-uppercase small">Link (Remoto)</label>
                <input asp-for="Link" type="url" class="form-control" placeholder="Ex: https://meet.jit.si/reuniao">
                <span asp-validation-for="Link" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Data" class="form-label fw-semibold text-primary text-uppercase small">Data</label>
                <input asp-for="Data" type="date" class="form-control">
                <span asp-validation-for="Data" class="text-danger small fw-semibold"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="HoraInicio" class="form-label fw-semibold text-primary text-uppercase small">Hora de
                        Início</label>
                        <input asp-for="HoraInicio" type="time" class="form-control">
                        <span asp-validation-for="HoraInicio" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="HoraTermino" class="form-label fw-semibold text-primary text-uppercase small">Hora de
                            Término</label>
                            <input asp-for="HoraTermino" type="time" class="form-control">
                            <span asp-validation-for="HoraTermino" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContatoId" class="form-label fw-semibold text-primary text-uppercase small">Contato Envolvido
                            (Opcional)</label>
                            <select asp-for="ContatoId" asp-items="Model.Contatos" class="form-select">
                                <option value="">Nenhum contato selecionado</option>
                            </select>
                            <span asp-validation-for="ContatoId" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
                            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
                        </div>
                    </form>
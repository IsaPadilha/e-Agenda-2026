@using eAgenda.WebApp.Modulos.Tarefas

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Tarefa";
}

@model EditarTarefaViewModel

<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-primary fw-bold">Editar Tarefa</h2>
    </div>

    <form class="card border-primary-subtle shadow-sm p-4" action="/Tarefa/Editar" method="post">
        
        <input type="hidden" name="Id" value="@Model.Id" />

        <div asp-validation-summary="All" class="text-danger alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Título</label>
            <input asp-for="Titulo" name="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Prioridade"
                   class="form-label fw-semibold text-primary text-uppercase small">Prioridade</label>
            <select asp-for="Prioridade" name="Prioridade" class="form-select">
                <option value="0">Baixa</option>
                <option value="1">Normal</option>
                <option value="2">Alta</option>
            </select>
            <span asp-validation-for="Prioridade" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" href="/Tarefa/Listar">Voltar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit">Salvar Alterações</button>
        </div>
    </form>
</div>
@using eAgenda.WebApp.Modulos.Tarefas

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Tarefa";
}

@model ExcluirTarefaViewModel

<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-danger fw-bold">Excluir Tarefa</h2>
    </div>

    <form class="card border-danger-subtle shadow-sm p-4" action="/Tarefa/Excluir" method="post">
        
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="alert alert-warning border-start border-warning border-4 rounded-3" role="alert">
            Tens a certeza de que pretendes excluir a tarefa <strong>@Model.Titulo</strong>?
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary text-uppercase small">Título</label>
            <p class="form-control-plaintext fw-bold">@Model.Titulo</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary text-uppercase small">Prioridade</label>
            <p class="form-control-plaintext">@Model.Prioridade</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary text-uppercase small">Data de Criação</label>
            <p class="form-control-plaintext">@Model.DataCriacao.ToShortDateString()</p>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-secondary rounded-pill px-4" href="/Tarefa/Listar">Cancelar</a>
            <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir</button>
        </div>
    </form>
</div>
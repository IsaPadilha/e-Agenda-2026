@using eAgenda.Aplicacao.Modulos.Despesas
@using eAgenda.Dominio.Modulos.Despesas

@model EditarDespesaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Despesa";
}

<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-primary fw-bold">Editar Despesa</h2>
    </div>

    <form class="card border-primary-subtle shadow-sm p-4" asp-controller="Despesa" asp-action="Editar"
          asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="All" class="text-danger alert alert-danger mb-3"></div>

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Descricao"
                   class="form-label fw-semibold text-primary text-uppercase small">Descrição</label>
            <input asp-for="Descricao" class="form-control" />
            <span asp-validation-for="Descricao" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DataOcorrencia" class="form-label fw-semibold text-primary text-uppercase small">Data de
                Ocorrência</label>
                <input asp-for="DataOcorrencia" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="DataOcorrencia" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Valor" class="form-label fw-semibold text-primary text-uppercase small">Valor</label>
                <input asp-for="Valor" type="number" step="0.01" lang="en-US" class="form-control" />
                <span asp-validation-for="Valor" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FormaPagamento" class="form-label fw-semibold text-primary text-uppercase small">Forma de
                    Pagamento</label>
                    <select asp-for="FormaPagamento" class="form-select">
                        <option value="0">À Vista</option>
                        <option value="1">Crédito</option>
                        <option value="2">Débito</option>
                    </select>
                    <span asp-validation-for="FormaPagamento" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-primary text-uppercase small">Categorias</label>

                    @foreach (var categoria in Model.CategoriasDisponiveis)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="CategoriasIds" value="@categoria.Id"
                                   checked="@(Model.CategoriasIds.Contains(categoria.Id))" />
                            <label class="form-check-label">
                                @categoria.Titulo
                            </label>
                        </div>
                    }
                    <span asp-validation-for="CategoriasIds" class="text-danger small fw-semibold"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-primary rounded-pill px-4" href="/Despesa/Listar">Voltar</a>
                    <button type="button" onclick="this.closest('form').submit();"
                            class="btn btn-primary rounded-pill px-4">Salvar</button>
                </div>
            </form>
        </div>
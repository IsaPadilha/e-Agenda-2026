@using eAgenda.Aplicacao.Modulos.Categorias;
@using eAgenda.WebApp.Modulos.Categorias;
@using Microsoft.AspNetCore.Mvc;
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Categoria";
}

@model eAgenda.WebApp.Modulos.Categorias.CadastrarCategoriaViewModel

<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-primary fw-bold">Cadastrar Nova Categoria</h2>
    </div>

    <form class="card border-primary-subtle shadow-sm p-4" action="/Categoria/Cadastrar" method="post">
        
        <div asp-validation-summary="All" class="text-danger alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Título</label>
            <input asp-for="Titulo" name="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" href="/Categoria/Listar">Voltar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit" formnovalidate>Cadastrar</button>
        </div>
    </form>
</div>
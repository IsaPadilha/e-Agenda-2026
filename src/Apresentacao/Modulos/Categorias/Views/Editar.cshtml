@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Categoria";
}

@model eAgenda.WebApp.Modulos.Categorias.EditarCategoriaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" action="/Categoria/Editar"
      method="post">
    

    <input type="hidden" name="Id" value="@Model.Id" />

    @if (ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]!.Errors.Count > 0)
    {
        <div asp-validation-summary="ModelOnly" class="text-danger alert alert-danger mb-3" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Título</label>
        <input asp-for="Titulo" name="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" href="/Categoria/Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
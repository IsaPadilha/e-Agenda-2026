@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Contato";
}

@model eAgenda.WebApp.Modulos.Contatos.CadastrarContatoViewModel

<div asp-validation-summary="All" class="text-danger alert alert-danger mb-3"></div>
<div class="container py-4" style="max-width: 620px;">
    <div class="mb-4">
        <h2 class="text-primary fw-bold">Cadastrar Novo Contato</h2>
    </div>

    <form class="card border-primary-subtle shadow-sm p-4" action="/Contato/Cadastrar" method="post">
        <div asp-validation-summary="All" class="text-danger alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
            <input asp-for="Nome" name="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label fw-semibold text-primary text-uppercase small">E-mail</label>
                <input asp-for="Email" type="email" name="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small fw-semibold"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Telefone"
                       class="form-label fw-semibold text-primary text-uppercase small">Telefone</label>
                <input asp-for="Telefone" name="Telefone" class="form-control" />
                <span asp-validation-for="Telefone" class="text-danger small fw-semibold"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Empresa"
                       class="form-label fw-semibold text-primary text-uppercase small">Empresa</label>
                <input asp-for="Empresa" name="Empresa" class="form-control" />
                <span asp-validation-for="Empresa" class="text-danger small fw-semibold"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Cargo" class="form-label fw-semibold text-primary text-uppercase small">Cargo</label>
                <input asp-for="Cargo" name="Cargo" class="form-control" />
                <span asp-validation-for="Cargo" class="text-danger small fw-semibold"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" href="/Contato/Listar">Voltar</a>
            <button class="btn btn-primary rounded-pill px-4" type="submit">Cadastrar</button>
        </div>
    </form>
</div>
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Contatos";
}

@model List<eAgenda.Aplicacao.Modulos.Contatos.ContatoDto>

<div class="container py-4" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">Contatos</h2>
        <a class="btn btn-primary rounded-pill px-4 shadow-sm" href="/Contato/Cadastrar">Cadastrar Novo</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm border-0 rounded-4 mt-4">
            Nenhum contato cadastrado ainda.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mt-4">
            @foreach (var contato in Model)
            {
                <div class="card border-primary-subtle shadow-sm p-4 rounded-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="fw-bold text-dark mb-0">@contato.Nome</h4>
                        <span class="badge bg-primary rounded-pill px-3 py-2 font-monospace">@contato.Id.ToString()[..8]</span>
                    </div>

                    <p class="text-secondary small mb-1">
                        📧 @contato.Email | 📱 @contato.Telefone
                    </p>

                    @if (!string.IsNullOrEmpty(contato.Empresa))
                    {
                        <p class="text-muted small mb-3">
                            🏢 @contato.Empresa @(!string.IsNullOrEmpty(contato.Cargo) ? $"({contato.Cargo})" : "")
                        </p>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <a class="btn btn-outline-primary rounded-pill px-4 btn-sm"
                           href="/Contato/Editar?id=@contato.Id">Editar</a>
                        <a class="btn btn-outline-danger rounded-pill px-4 btn-sm"
                           href="/Contato/Excluir?id=@contato.Id">Excluir</a>
                    </div>
                </div>
            }
        </div>
    }
</div>